# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Exchange connectivity ---------------------------------------------------
EXCHANGE_ID=binance
API_KEY=
API_SECRET=
API_PASSWORD=
USE_TESTNET=true
DRY_RUN=true

# --- Market -------------------------------------------------------------
SYMBOL=BTC/USDT
TIMEFRAME_TREND=4h
TIMEFRAME_ENTRY=1h
ORDER_BOOK_DEPTH=50
WHALE_TRADE_USD_THRESHOLD=250000

# --- Strategy -----------------------------------------------------------
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50
EMA_TREND_PERIOD=200
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ATR_PERIOD=14
ORDERBOOK_IMBALANCE_THRESHOLD=0.15
HEATMAP_PROXIMITY_PCT=0.004

# --- Risk management ------------------------------------------------------
RISK_PER_TRADE_PCT=0.01
ATR_STOP_MULTIPLIER=1.5
RISK_REWARD_RATIO=2.5
TRAILING_ACTIVATION_RR=1.0
TRAILING_ATR_MULTIPLIER=1.2
MAX_DAILY_DRAWDOWN_PCT=0.05
MAX_OPEN_POSITIONS=1
MAX_POSITION_PCT_OF_EQUITY=0.5

# --- Execution / fees -----------------------------------------------------
MAKER_FEE_PCT=0.0005
TAKER_FEE_PCT=0.001
SLIPPAGE_BPS=5
LOOP_INTERVAL_SECONDS=300
MAX_CONSECUTIVE_ERRORS=5

# --- Backtesting ----------------------------------------------------------
BACKTEST_YEARS=2
BACKTEST_INITIAL_EQUITY=10000
WALK_FORWARD_FOLDS=6

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=trading_bot.log
TRADE_JOURNAL_FILE=trade_journal.jsonl
